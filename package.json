{
  "name": "ComfyUI-Workflow-Studio",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/HibernalGlow/ComfyUI-Workflow-Studio.git",
  "author": "HibernalGlow <3090253564@qq.com>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node tools/dev-server.js",
    "start": "node tools/dev-server.js",
    "prebuild": "node -e \"require('fs').rmSync('static/newui',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "build:watch": "vite build --watch",
    "fe:dev": "vite",
    "test:core": "node --test tools/core-tests/",
    "check:newui": "bash tools/check-newui.sh"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@lit/react": "^1.0.8",
    "@material/web": "^2.5.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "material-symbols": "^0.47.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
